<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BOOKORIA</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BOOKORIA.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light border-bottom shadow-sm sticky-top main-navbar">
            <div class="container">
                <a class="navbar-brand brand-logo" asp-area="" asp-page="/Index">
                    <span class="brand-logo-mark" aria-hidden="true">
                        <svg viewBox="0 0 48 48" width="28" height="28" role="img">
                            <rect x="4" y="8" width="18" height="32" rx="4" fill="#8b6f4e"></rect>
                            <rect x="26" y="8" width="18" height="32" rx="4" fill="#c8ad89"></rect>
                            <rect x="22" y="8" width="4" height="32" fill="#fff"></rect>
                        </svg>
                    </span>
                    <span class="brand-logo-text">BOOKORIA</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse justify-content-between">
                    <ul class="navbar-nav align-items-lg-center gap-lg-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Books/Index"><i class="bi bi-book me-1"></i>Books</a>
                        </li>
                        @if (User.IsInRole("Customer"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-page="/Cart/Index"><i class="bi bi-bag me-1"></i>Cart</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-page="/Orders/History"><i class="bi bi-receipt me-1"></i>My Orders</a>
                            </li>
                        }
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-page="/Admin/Index"><i class="bi bi-speedometer2 me-1"></i>Admin Dashboard</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-page="/Admin/Books/Index"><i class="bi bi-journal-richtext me-1"></i>Admin Books</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-page="/Admin/Categories/Index"><i class="bi bi-tags me-1"></i>Admin Categories</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-page="/Admin/Orders/Index"><i class="bi bi-truck me-1"></i>Admin Orders</a>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav align-items-lg-center gap-lg-1">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Account/Profile"><i class="bi bi-person-circle me-1"></i>Profile</a>
                            </li>
                            <li class="nav-item d-flex align-items-center me-2 text-muted user-chip">
                                <i class="bi bi-person me-1"></i>@User.Identity.Name (@(User.IsInRole("Admin") ? "Admin" : "Customer"))
                            </li>
                            <li class="nav-item">
                                <form method="post" asp-page="/Account/Logout">
                                    <button type="submit" class="btn btn-link nav-link">Logout</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Account/Login"><i class="bi bi-box-arrow-in-right me-1"></i>Login</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Account/Register"><i class="bi bi-person-plus me-1"></i>Register</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container py-3">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 footer-wrap">
                <div class="small">&copy; 2026 BOOKORIA</div>
                <div class="small footer-links d-flex gap-3">
                    <a asp-area="" asp-page="/Books/Index">Sách</a>
                    <a asp-area="" asp-page="/Privacy">Chính sách</a>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>