@page
@model BOOKORIA.Pages.Admin.Orders.IndexModel
@{
    ViewData["Title"] = "Quản lý đơn hàng";
}

<h1 class="h3 mb-3">Quản lý đơn hàng</h1>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-light">
                <tr>
                    <th>Mã đơn</th>
                    <th>Khách hàng</th>
                    <th>Ngày tạo</th>
                    <th>Loại đơn</th>
                    <th>Thanh toán</th>
                    <th>Trạng thái đơn</th>
                    <th>Vận chuyển</th>
                    <th class="text-end">Tổng tiền</th>
                    <th></th>
                </tr>
                </thead>
                <tbody>
                @if (!Model.Orders.Any())
                {
                    <tr>
                        <td colspan="9" class="text-center py-4 text-muted">Chưa có đơn hàng.</td>
                    </tr>
                }
                else
                {
                    foreach (var order in Model.Orders)
                    {
                        <tr>
                            <td class="small">@order.Id</td>
                            <td>@order.Customer</td>
                            <td>@order.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@order.OrderType</td>
                            <td>@order.PaymentStatus</td>
                            <td>@order.Status</td>
                            <td>@(order.ShippingStatus?.ToString() ?? "-")</td>
                            <td class="text-end">@order.TotalAmount.ToString("N0") đ</td>
                            <td class="text-end">
                                <a asp-page="/Admin/Orders/Edit" asp-route-id="@order.Id" class="btn btn-sm admin-btn-edit admin-btn-wide">Sửa trạng thái</a>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
