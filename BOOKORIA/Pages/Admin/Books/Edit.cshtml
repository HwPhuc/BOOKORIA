@page "{id:guid}"
@model BOOKORIA.Pages.Admin.Books.EditModel
@{
    ViewData["Title"] = "Sửa sách";
}

<h1 class="mb-4">Sửa sách</h1>

<form method="post" enctype="multipart/form-data" class="row g-3">
    <input asp-for="Input.Id" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="col-md-6">
        <label asp-for="Input.Title" class="form-label"></label>
        <input asp-for="Input.Title" class="form-control" />
        <span asp-validation-for="Input.Title" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Input.Author" class="form-label"></label>
        <input asp-for="Input.Author" class="form-control" />
        <span asp-validation-for="Input.Author" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Input.Isbn" class="form-label"></label>
        <input asp-for="Input.Isbn" class="form-control" />
        <span asp-validation-for="Input.Isbn" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Input.PriceEbook" class="form-label"></label>
        <input asp-for="Input.PriceEbook" class="form-control" />
        <span asp-validation-for="Input.PriceEbook" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Input.PricePrint" class="form-label"></label>
        <input asp-for="Input.PricePrint" class="form-control" />
        <span asp-validation-for="Input.PricePrint" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Input.Stock" class="form-label"></label>
        <input asp-for="Input.Stock" class="form-control" />
        <span asp-validation-for="Input.Stock" class="text-danger"></span>
    </div>

    <div class="col-12">
        <label class="form-label">Thể loại</label>
        <div class="border rounded p-3 bg-light">
            @if (Model.Categories.Any())
            {
                <div class="row g-2">
                    @foreach (var category in Model.Categories)
                    {
                        var isChecked = Model.Input.SelectedCategoryIds.Contains(category.Id);
                        <div class="col-12 col-md-6 col-lg-4">
                            <div class="form-check">
                                <input class="form-check-input"
                                       type="checkbox"
                                       name="Input.SelectedCategoryIds"
                                       value="@category.Id"
                                       id="cat_@category.Id"
                                       checked="@isChecked" />
                                <label class="form-check-label" for="cat_@category.Id">@category.Name</label>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-muted small">Chưa có thể loại nào trong hệ thống.</div>
            }
        </div>
    </div>

    <div class="col-12 mt-1">
        <div class="form-check ps-0 mb-0">
            <input asp-for="Input.IsActive" class="form-check-input float-none ms-0 me-2" />
            <label asp-for="Input.IsActive" class="form-check-label"></label>
        </div>
    </div>

    <div class="col-12">
        <label asp-for="Input.Description" class="form-label"></label>
        <textarea asp-for="Input.Description" class="form-control" rows="5"></textarea>
        <span asp-validation-for="Input.Description" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Input.CoverFile" class="form-label">Ảnh bìa (upload mới để thay thế)</label>
        <input asp-for="Input.CoverFile" type="file" class="form-control" accept="image/*" />
        @if (!string.IsNullOrWhiteSpace(Model.Input.CurrentCoverUrl))
        {
            <div class="mt-2">
                <img src="@Model.Input.CurrentCoverUrl" alt="cover" class="img-thumbnail" style="max-height: 180px;" />
            </div>
        }
    </div>

    <div class="col-md-4">
        <label asp-for="Input.FullPdfFile" class="form-label">PDF đầy đủ (upload mới để thay thế)</label>
        <input asp-for="Input.FullPdfFile" type="file" class="form-control" accept="application/pdf" />
        @if (!string.IsNullOrWhiteSpace(Model.Input.CurrentFullPdfUrl))
        {
            <div class="mt-2">
                <a href="@Model.Input.CurrentFullPdfUrl" target="_blank" rel="noopener noreferrer">Xem file hiện tại</a>
            </div>
        }
    </div>

    <div class="col-md-4">
        <label asp-for="Input.SamplePdfFile" class="form-label">PDF đọc thử (upload mới để thay thế)</label>
        <input asp-for="Input.SamplePdfFile" type="file" class="form-control" accept="application/pdf" />
        @if (!string.IsNullOrWhiteSpace(Model.Input.CurrentSamplePdfUrl))
        {
            <div class="mt-2">
                <a href="@Model.Input.CurrentSamplePdfUrl" target="_blank" rel="noopener noreferrer">Xem file hiện tại</a>
            </div>
        }
    </div>

    <div class="col-12 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
        <a asp-page="/Admin/Books/Index" class="btn btn-outline-secondary">Huỷ</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
